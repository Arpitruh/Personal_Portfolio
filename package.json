{
  "name": "arpit-portfolio-world",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "test:e2e": "playwright test",
    "check:unit": "npm run typecheck && npm test && npm run build",
    "audit:lighthouse": "node scripts/lighthouse-audit.mjs",
    "audit:security": "npm audit --omit=dev --audit-level=high"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/press-start-2p": "5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "@playwright/test": "^1.56.1",
    "@axe-core/playwright": "^4.11.1",
    "lighthouse": "^12.8.2",
    "chrome-launcher": "^1.2.1"
  }
}
